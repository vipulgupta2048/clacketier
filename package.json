{
	"name": "cmd-mod-clacketier",
	"version": "0.2.0",
	"description": "Real Cherry MX Blue, Brown and Red keyboard recordings under every key you type into Command Code. Low-latency on macOS.",
	"type": "module",
	"license": "MIT",
	"author": {
		"name": "Vipul Gupta",
		"url": "https://mixster.dev"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/vipulgupta2048/clacketier.git"
	},
	"homepage": "https://github.com/vipulgupta2048/clacketier#readme",
	"bugs": "https://github.com/vipulgupta2048/clacketier/issues",
	"keywords": [
		"cmd-mod",
		"cmd-mod-command",
		"mechanical-keyboard",
		"cherry-mx",
		"typing-sounds",
		"commandcode"
	],
	"commandcode": {
		"mods": [
			"./index.ts"
		]
	},
	"files": [
		"index.ts",
		"src",
		"!src/__tests__",
		"players",
		"sounds"
	],
	"scripts": {
		"test": "vitest run && /usr/bin/python3 -m unittest discover -s cli/terminal",
		"typecheck": "tsc --noEmit"
	},
	"devDependencies": {
		"@types/node": "^24.10.9",
		"typescript": "^5.9.2",
		"vitest": "^4.1.11"
	}
}
